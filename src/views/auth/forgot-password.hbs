<div class="auth-card card">
  <div class="card-header">
    <h2><i class="bi bi-key-fill"></i> Recuperar Contraseña</h2>
    <p>Ingresa tu correo para recibir un enlace de recuperación</p>
  </div>
  <div class="card-body">

    {{#if error}}
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> {{error}}
      </div>
    {{/if}}

    {{#if success}}
      <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i> {{message}}
      </div>

      {{#if resetLink}}
        <div class="card" style="background: var(--cream); border: 1px dashed var(--terracotta); margin-top: 1rem;">
          <div class="card-body text-center">
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.5rem;">
              <i class="bi bi-info-circle"></i> Enlace de prueba (solo desarrollo):
            </p>
            <a href="{{resetLink}}" style="font-family: monospace; font-size: 0.85rem; word-break: break-all; color: var(--terracotta);">
              {{resetLink}}
            </a>
          </div>
        </div>
      {{/if}}

      <div class="text-center mt-3">
        <a href="/login" class="btn btn-primary">
          <i class="bi bi-box-arrow-in-right"></i> Volver al Login
        </a>
      </div>
    {{else}}
      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label for="email">
            <i class="bi bi-envelope"></i> Correo electrónico
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="tu@correo.com"
            required
            autofocus
          >
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt-2">
          <i class="bi bi-send"></i> Enviar enlace de recuperación
        </button>
      </form>

      <div class="text-center mt-3">
        <a href="/login" style="font-size: 0.9rem;">
          <i class="bi bi-arrow-left"></i> Volver al Login
        </a>
      </div>
    {{/if}}
  </div>
</div>
