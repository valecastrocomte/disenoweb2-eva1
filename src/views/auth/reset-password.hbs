<div class="auth-card card">
  <div class="card-header">
    <h2><i class="bi bi-shield-lock-fill"></i> Restablecer Contraseña</h2>
    <p>Ingresa tu nueva contraseña</p>
  </div>
  <div class="card-body">

    {{#if error}}
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> {{error}}
      </div>
    {{/if}}

    {{#if expired}}
      <div class="text-center mt-2">
        <a href="/forgot-password" class="btn btn-primary">
          <i class="bi bi-send"></i> Solicitar nuevo enlace
        </a>
      </div>
    {{else}}
      <form action="/reset-password/{{token}}" method="POST">
        <div class="form-group">
          <label for="password">
            <i class="bi bi-lock"></i> Nueva Contraseña
          </label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="Mínimo 8 caracteres, 1 letra y 1 número"
            required
            minlength="8"
            autofocus
          >
          <small class="text-muted" style="font-size: 0.8rem; margin-top: 0.3rem; display: block;">
            Debe contener al menos 8 caracteres con una letra y un número.
          </small>
        </div>

        <div class="form-group">
          <label for="confirmPassword">
            <i class="bi bi-lock-fill"></i> Confirmar Nueva Contraseña
          </label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            class="form-control"
            placeholder="Repite tu nueva contraseña"
            required
            minlength="8"
          >
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt-2">
          <i class="bi bi-check-lg"></i> Guardar Nueva Contraseña
        </button>
      </form>
    {{/if}}

    <div class="text-center mt-3">
      <a href="/login" style="font-size: 0.9rem;">
        <i class="bi bi-arrow-left"></i> Volver al Login
      </a>
    </div>
  </div>
</div>
