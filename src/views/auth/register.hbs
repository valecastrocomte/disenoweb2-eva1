<div class="auth-card card">
  <div class="card-header">
    <h2><i class="bi bi-person-plus-fill"></i> Crear Cuenta</h2>
    <p>Únete y organiza tu biblioteca personal</p>
  </div>
  <div class="card-body">

    {{#if error}}
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> {{error}}
      </div>
    {{/if}}

    <form action="/register" method="POST">
      <div class="form-group">
        <label for="name">
          <i class="bi bi-person"></i> Nombre completo
        </label>
        <input
          type="text"
          id="name"
          name="name"
          class="form-control"
          placeholder="Tu nombre"
          value="{{name}}"
          required
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="email">
          <i class="bi bi-envelope"></i> Correo electrónico
        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          placeholder="tu@correo.com"
          value="{{email}}"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">
          <i class="bi bi-lock"></i> Contraseña
        </label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          placeholder="Mínimo 8 caracteres, 1 letra y 1 número"
          required
          minlength="8"
        >
        <small class="text-muted" style="font-size: 0.8rem; margin-top: 0.3rem; display: block;">
          Debe contener al menos 8 caracteres con una letra y un número.
        </small>
      </div>

      <div class="form-group">
        <label for="confirmPassword">
          <i class="bi bi-lock-fill"></i> Confirmar contraseña
        </label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          class="form-control"
          placeholder="Repite tu contraseña"
          required
          minlength="8"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg mt-2">
        <i class="bi bi-person-plus"></i> Crear Cuenta
      </button>
    </form>
  </div>
  <div class="card-footer">
    ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
  </div>
</div>
